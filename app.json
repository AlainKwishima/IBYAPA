{
  "expo": {
    "name": "IBYAPA",
    "slug": "nkotanyi",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ibyapa",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ibyapa.app",
      "infoPlist": {
        "UIRequiresFullScreen": false,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ibyapa.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9FAFB"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "transparent",
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "dark-content",
      "backgroundColor": "#F9FAFB"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "IBYAPA",
      "shortName": "IBYAPA",
      "lang": "en",
      "description": "Road safety learning and driving exam preparation.",
      "themeColor": "#4A78D0",
      "backgroundColor": "#F9FAFB",
      "display": "standalone",
      "orientation": "any"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F9FAFB"
        }
      ]
    ]
  }
}
